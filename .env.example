# Copy to .env and fill in. Never commit the real .env.

# Workspace + app service principal (Databricks Apps injects these when deployed)
DATABRICKS_HOST=your-workspace.cloud.databricks.com
DATABRICKS_WORKSPACE_ID=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# AI/BI dashboard + Genie space
DATABRICKS_DASHBOARD_ID=
DATABRICKS_GENIE_SPACE_ID=

# One service principal per tenant: Unity Catalog row-level security keys off
# the SP that calls Genie, so each tenant's Genie calls only see its own rows.
GENIE_SP_CLIENT_ID_APEX=
GENIE_SP_CLIENT_SECRET_APEX=
GENIE_SP_CLIENT_ID_SYNERGY=
GENIE_SP_CLIENT_SECRET_SYNERGY=

# Signing keys for Flask sessions and the app JWT. Generate each with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
JWT_SECRET_KEY=
